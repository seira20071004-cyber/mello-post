# Server only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Required when NODE_ENV=production (enter the same password in the app).
APP_PASSWORD=
# Optional: your own per-image USD estimate. Empty means no price estimate.
IMAGE_ESTIMATE_USD=
# Metadata only: timestamp, operation, outcome, tokens. No prompts/images/key.
USAGE_LOG_PATH=.data/usage.jsonl

# Google sign-in (optional, use "google" to enable).
# Register APP_AUTH_ORIGIN + /api/auth/google/callback as the redirect URI in Google Cloud.
# Use separate credentials and session secrets for local and hosted environments.
# APP_AUTH_MODE=google
# APP_AUTH_ORIGIN=http://127.0.0.1:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_SESSION_SECRET=  # Generate with openssl rand -hex 32
# APP_ADMIN_EMAIL=  # One Google account. Other users need a single-use invitation.
# APP_INVITE_DB_PATH=.data/invites.sqlite  # Use persistent disk for Node production.
# For hosted D1, apply docs/sql/invites.sql and set these server-side:
# APP_D1_ACCOUNT_ID=
# APP_D1_DATABASE_ID=
# APP_D1_TOKEN=
