# Server only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Required when NODE_ENV=production (enter the same password in the app).
APP_PASSWORD=
# Optional: your own per-image USD estimate. Empty means no price estimate.
IMAGE_ESTIMATE_USD=
# Metadata only: timestamp, operation, outcome, tokens. No prompts/images/key.
USAGE_LOG_PATH=.data/usage.jsonl
